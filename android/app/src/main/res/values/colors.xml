<?xml version="1.0" encoding="utf-8"?>
<!--
    Те же цвета, что в окне на компьютере: приложение должно узнаваться, а не
    выглядеть роднёй по случайному совпадению.
-->
<resources>
    <color name="bg">#0d1017</color>
    <color name="card">#161a23</color>
    <color name="card2">#1d222d</color>
    <color name="line">#272d3a</color>
    <color name="text">#e8ebf2</color>
    <color name="dim">#828b9e</color>
    <color name="accent">#4c8dff</color>
    <!-- Приглушённый синий для крупных заливок (главные кнопки, галочки,
         переключатели) — тот же оттенок, что и accent, но темнее и менее
         насыщенный, чтобы не бросался в глаза на тёмной теме (как на иконке
         приложения, где яркий синий притушен зерном). Сам accent остаётся
         как есть — для мелких акцентов текста и ссылок. -->
    <color name="accent_muted">#3d5f8a</color>
    <color name="accent_muted_dark">#2c4665</color>
    <color name="ok">#2fbf71</color>
    <color name="warn">#e8b339</color>
    <color name="err">#e5484d</color>
    <!-- Приглушённый красный для опасной кнопки («Удалить сервер») — тот же
         приём, что и с accent_muted: темнее и менее насыщенный, чем err,
         которым помечают ошибки, чтобы кнопка не была ярче самой ошибки. -->
    <color name="err_muted">#8a3d3d</color>
    <color name="err_muted_dark">#652c2c</color>
    <!-- Логотип в шапке — тот же приглушённый синий, что и у кнопок, а не
         яркий голубой сам по себе: раньше он единственный выделялся на фоне
         остальной, уже притушенной, палитры. -->
    <color name="logo">@color/accent_muted</color>


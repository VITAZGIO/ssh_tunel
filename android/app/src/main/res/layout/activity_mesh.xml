<?xml version="1.0" encoding="utf-8"?>
<!-- Сеть устройств — отдельным экраном, как блокировка рекламы. Настройки
     относятся к активному серверу: сеть живёт на нём (см. docs/MESH.md). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout style="@style/HeadRow">
        <ImageView
            android:id="@+id/backFromMesh"
            style="@style/HeadIcon"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

        <TextView style="@style/HeadTitle" android:text="@string/mesh_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:textSize="13sp"
                android:textColor="@color/text"
                android:text="@string/mesh_intro" />

            <TextView
                android:id="@+id/meshServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:textSize="12.5sp"
                android:textColor="@color/dim" />

            <CheckBox
                android:id="@+id/meshEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:text="@string/mesh_enable" />

            <TextView style="@style/FieldLabel" android:text="@string/mesh_name" />
            <EditText android:id="@+id/meshName" style="@style/Field"
                android:inputType="text" android:maxLength="64"
                android:textColorHint="@color/dim" android:autofillHints="" />

            <TextView style="@style/FieldLabel" android:text="@string/mesh_key" />
            <EditText android:id="@+id/meshKey" style="@style/Field"
                android:inputType="textNoSuggestions" android:typeface="monospace"
                android:textSize="12sp" android:textColorHint="@color/dim" android:autofillHints="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/meshPasteKey"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/adblock_paste" />
                <Space android:layout_width="6dp" android:layout_height="1dp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/meshCopyKey"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/adblock_copy" />
                <Space android:layout_width="6dp" android:layout_height="1dp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/meshNewKey"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="@string/mesh_new" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textSize="12sp"
                android:textColor="@color/dim"
                android:text="@string/mesh_key_hint" />

            <CheckBox
                android:id="@+id/meshIncoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:text="@string/mesh_incoming" />

            <CheckBox
                android:id="@+id/meshDirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:text="@string/mesh_direct" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/dim"
                android:text="@string/mesh_direct_hint" />

            <TextView
                android:id="@+id/meshNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/dim"
                android:text="@string/mesh_reconnect_note" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/dim"
                android:text="@string/mesh_devices" />

            <TextView
                android:id="@+id/meshState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:textSize="12.5sp"
                android:textColor="@color/dim" />

            <LinearLayout
                android:id="@+id/meshPeers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

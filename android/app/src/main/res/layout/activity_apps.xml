<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout style="@style/HeadRow">
        <ImageView
            android:id="@+id/backFromApps"
            style="@style/HeadIcon"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

        <TextView style="@style/HeadTitle" android:text="@string/apps_title" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:textSize="12sp"
        android:textColor="@color/dim"
        android:text="@string/apps_hint" />

    <RadioGroup
        android:id="@+id/mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/modeAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:text="@string/mode_all" />

        <RadioButton
            android:id="@+id/modeOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:text="@string/mode_only" />

        <RadioButton
            android:id="@+id/modeExcept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:text="@string/mode_except" />
    </RadioGroup>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:choiceMode="multipleChoice"
        android:divider="@color/line"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/appsNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/dim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/exportAppsBtn"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:textSize="12sp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/export_apps" />

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/importAppsBtn"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:textSize="12sp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/import_apps" />

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/pasteAppsBtn"
            style="@style/SecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:textSize="12sp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/paste_apps_list" />
    </LinearLayout>
</LinearLayout>

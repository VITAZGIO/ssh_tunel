<?xml version="1.0" encoding="utf-8"?>
<!-- Исключения доменов: два списка — «всегда напрямую» и «всегда в туннель».
     Кнопки сверху сдвигают ленту со списками вбок (код двигает translationX),
     внизу — перенос обоих списков через буфер или файлом. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/c_bg"
    android:padding="16dp">

    <LinearLayout style="@style/HeadRow">
        <ImageView
            android:id="@+id/backFromDomains"
            style="@style/HeadIcon"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

        <TextView style="@style/HeadTitle" android:text="@string/domains_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/domTabs"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_outline"
                android:showDividers="middle"
                android:divider="@drawable/bg_seg_div">
                <TextView style="@style/SegItem" android:tag="direct" android:text="@string/direct" />
                <TextView style="@style/SegItem" android:tag="tunnel" android:text="@string/tunnel_label" />
            </LinearLayout>

            <!-- Лента шириной в два экрана: видна половина. -->
            <FrameLayout
                android:id="@+id/domViewport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="true">
                <LinearLayout
                    android:id="@+id/domTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/paneDirect"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="?attr/c_dim"
                                android:text="@string/direct_sub" />
                            <TextView
                                android:id="@+id/directInfo"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:background="@drawable/bg_infoq"
                                android:gravity="center"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="?attr/c_dim"
                                android:text="?"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                        <EditText
                            android:id="@+id/directEdit"
                            style="@style/Field"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:minLines="7"
                            android:gravity="top"
                            android:hint="@string/direct_hint"
                            android:textColorHint="?attr/c_dim"
                            android:autofillHints="" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/paneTunnel"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="?attr/c_dim"
                                android:text="@string/tunnel_sub" />
                            <TextView
                                android:id="@+id/tunnelInfo"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:background="@drawable/bg_infoq"
                                android:gravity="center"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="?attr/c_dim"
                                android:text="?"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                        <EditText
                            android:id="@+id/tunnelEdit"
                            style="@style/Field"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:minLines="7"
                            android:gravity="top"
                            android:hint="@string/tunnel_hint"
                            android:textColorHint="?attr/c_dim"
                            android:autofillHints="" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView style="@style/SectTitle" android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp" android:text="@string/domains_xfer" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <LinearLayout
                    android:id="@+id/xferModeSeg"
                    style="@style/XferSeg">
                    <TextView style="@style/XferSegItem" android:tag="clip" android:text="@string/xfer_clip" />
                    <TextView style="@style/XferSegItem" android:tag="file" android:text="@string/xfer_file" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_outline"
                android:showDividers="middle"
                android:divider="@drawable/bg_seg_div">
                <TextView android:id="@+id/domImportBtn" style="@style/SegItem" android:text="@string/import_short" />
                <TextView android:id="@+id/domExportBtn" style="@style/SegItem" android:text="@string/export_short" />
            </LinearLayout>
            <TextView
                android:id="@+id/domNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textColor="?attr/c_dim" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/saveDomains"
                style="@style/PrimaryButton"
                android:layout_marginTop="22dp"
                android:text="@string/save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

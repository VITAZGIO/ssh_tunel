<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        Начиная с Android 14 у постоянной службы обязан быть объявлен тип.
        Для приложений, которые работают через VpnService, предусмотрен
        специальный тип: обычные (воспроизведение, синхронизация и прочие)
        сюда не подходят по смыслу.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Начиная с Android 13 уведомление нельзя показать без разрешения. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Список установленных приложений нужен для экрана исключений. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Только чтобы отсканировать QR с настройками — приложение не снимает
         фото и не пишет видео, само разрешение спрашивается по нажатию. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:label="@string/apps_title" />

        <activity
            android:name=".AdBlockActivity"
            android:exported="false"
            android:label="@string/ad_block_title" />

        <!--
            Кнопка в шторке быстрых настроек. Разрешение выдаёт система: с ним
            запускать её может только она сама.
        -->
        <service
            android:name=".TunnelTile"
            android:exported="true"
            android:icon="@drawable/ic_notify"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Служба туннеля. Разрешение BIND_VPN_SERVICE выдаёт система, и
            благодаря ему запустить службу может только она сама — после того,
            как человек подтвердил запрос на создание VPN-подключения.

            android.net.VpnService intent-filter — по нему система находит эту
            службу в списке «Всегда включённый VPN» (Настройки → Сеть → VPN →
            шестерёнка). SUPPORTS_ALWAYS_ON=true объявлен явно, хотя это и так
            значение по умолчанию: без него сюда же попадает и режим
            «Блокировать соединения без VPN» — оба переключаются в одном месте
            системных настроек, отдельно объявлять второй не нужно.

            Собственного «выключателя» на утечку трафика мимо туннеля здесь
            нет и не должно быть: система уже гарантирует его сама в режиме
            блокировки, а свой — это лишний код и лишний повод ошибиться.
            TunnelService.startTunnel читает последний сохранённый профиль
            прямо из SharedPreferences, поэтому запуск системой без открытия
            приложения (ровно так стартует always-on VPN после перезагрузки)
            поднимает туннель с теми же настройками, что были в последний раз.
        -->
        <service
            android:name=".TunnelService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>
    </application>
</manifest>
